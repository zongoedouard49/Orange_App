# URL de base de votre backend FastAPI. Copiez ce fichier en .env.local
# et adaptez la valeur si besoin, puis redémarrez `npm run dev`.
# Le backend FastAPI n'utilise pas de préfixe /api sur ses routes
# (ex: /user/login, /admin/login, /services, /renseignements/...).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
