# ═══════════════════════════════════════════════════════════════
#  Configuration Orange Burkina — Plateforme de renseignements
# ═══════════════════════════════════════════════════════════════

# ─── Sécurité JWT ───────────────────────────────────────────────
SECRET_KEY=super-secret-key-changez-moi-en-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ─── API externe d'authentification utilisateur ─────────────────
EXTERNAL_API_URL=http://127.0.0.1:4000/authentification
EXTERNAL_API_TIMEOUT=30

# ─── Rate Limiting (requêtes par IP) ────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1

# ─── Rate Limiting Login (tentatives par CUID) ──────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1800

# ─── Base de données ────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ─── Admin par défaut ───────────────────────────────────────────
DEFAULT_ADMIN_CUID=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ─── Statuts valides (séparés par des virgules) ────────────────
STATUTS_VALIDES=employé,prestataire,stagiaire,contractuel

# ─── Pagination ─────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ─── Commande ARP (selon l'OS) ──────────────────────────────────
# Windows : ARP_OPTION=-a      Linux : ARP_OPTION=-n (ou -a)
ARP_COMMAND=arp
ARP_OPTION=-a

# ─── CORS / CSRF ────────────────────────────────────────────────
# Origines du frontend autorisées (séparées par des virgules, sans "/" final).
# Ajouter l'URL exacte utilisée par les navigateurs (ex: http://192.168.1.10:3000).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_MAX_AGE=28800
# lax (défaut) | strict | none  ("none" exige CSRF_COOKIE_SECURE=true, donc HTTPS)
CSRF_COOKIE_SAMESITE=lax
CSRF_COOKIE_SECURE=false

# ─── Temps réel (WebSocket) ─────────────────────────────────────
# Nécessite un seul processus uvicorn (hub en mémoire).
REALTIME_ENABLED=true
REALTIME_MAX_CONNECTIONS=500

# ─── Serveur ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
