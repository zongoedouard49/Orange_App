# ═══════════════════════════════════════════════════════════════
#  Configuration Orange Burkina — Plateforme de renseignements
# ═══════════════════════════════════════════════════════════════

# ─── Sécurité JWT ───────────────────────────────────────────────
SECRET_KEY=super-secret-key-changez-moi-en-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── API externe d'authentification utilisateur ─────────────────
EXTERNAL_API_URL=http://localhost:8001/verify
EXTERNAL_API_TIMEOUT=10

# ─── Rate Limiting (requêtes par IP) ────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1

# ─── Rate Limiting Login (tentatives par CUID) ──────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1800

# ─── Base de données ────────────────────────────────────────────
DATABASE_URL=sqlite:///./app.db

# ─── Admin par défaut ───────────────────────────────────────────
DEFAULT_ADMIN_CUID=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ─── Statuts valides (séparés par des virgules) ────────────────
STATUTS_VALIDES=employé,prestataire,stagiaire,contractuel

# ─── Serveur ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
